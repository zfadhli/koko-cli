{
  "name": "@zfadhli/koko-cli",
  "type": "module",
  "version": "0.2.1",
  "description": "Composition-based CLI toolkit — wraps cac, picocolors, cli-progress, cli-spinners",
  "license": "MIT",
  "author": "Koko contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zfadhli/koko-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zfadhli/koko-cli/issues"
  },
  "homepage": "https://github.com/zfadhli/koko-cli#readme",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "example:color": "nub examples/01-color.ts",
    "example:spinner": "nub examples/02-spinner.ts",
    "example:progress": "nub examples/03-progress.ts",
    "example:cli": "nub examples/04-cli-app.ts",
    "example:composition": "nub examples/05-composition.ts",
    "examples": "nub examples/01-color.ts && nub examples/02-spinner.ts && nub examples/03-progress.ts && nub examples/04-cli-app.ts --help && nub examples/05-composition.ts"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "cli-progress": "^3.12.0",
    "cli-spinners": "^3.4.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/cli-progress": "^3.11.0",
    "lefthook": "^2.1.9",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "nub@0.1.5",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.1.5",
      "onFail": "warn"
    }
  }
}
